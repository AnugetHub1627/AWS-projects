name: "Test-Deploy K8s Infrastructure"

# Triggers instantly every time you push code to your main branch
on:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  deploy-infra:
    name: "Full Terraform Pipeline Run"
    runs-on: ubuntu-latest
    
    defaults:
      run:
        working-directory: ./terraform

    steps:
    # 1. Pull down your repository files
    - name: Checkout Source Code
      uses: actions/checkout@v4

    # 2. Spin up the Terraform engine
    - name: Setup Terraform CLI
      uses: hashicorp/setup-terraform@v3
      with:
        terraform_version: 1.7.0

    # 3. Log in to your AWS Account using your Secrets
    - name: Configure AWS Credentials
      uses: aws-actions/configure-aws-credentials@v4
      with:
        aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
        aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        aws-region: ap-south-1

    # 4. Initialize the working directory
    - name: Terraform Init
      run: terraform init

    # 5. Check code formatting style (Will fail if your files are messy)
    - name: Terraform Format Check
      run: terraform fmt -check

    # 6. Validate the structural syntax of your code
    - name: Terraform Validate
      run: terraform validate

    # 7. Generate a preview plan in the logs of what will change
    - name: Terraform Plan
      run: terraform plan -input=false

    # 8. Run the creation script directly without any intermediate stops
    - name: Terraform Apply (Direct Build)
      run: terraform apply -auto-approve -input=false
